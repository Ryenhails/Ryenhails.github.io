---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Zhuchenyang Liu",
  description = "Doctoral researcher at Aalto University working on efficient visual document retrieval: vision-language models, knowledge distillation and index compression.",
} = Astro.props;

const site = "https://ryenhails.github.io";
const ogImage = `${site}/images/photo.jpg`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${site}/`} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0d0d0e" media="(prefers-color-scheme: dark)" />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${site}/`} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script is:inline src="/oneko.js" data-cat="/images/oneko.gif"></script>
</body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Aalto Block: colour appears as a filled field, type is black or white,
     dividing is done by hard rules. Nothing is rounded. */
  :root {
    --page:        #ffffff;
    --ink:         #0a0a0a;
    --ink-2:       #4a4a4a;
    --ink-3:       #8a8a8a;
    --rule:        #e2e2e0;
    --rule-strong: #0a0a0a;
    --surface:     #f6f6f4;

    /* Aalto ELEC. The dark school value fills with white type on light ground;
       the light value takes over in dark mode, where the dark one would vanish. */
    --brand:    #392d56;   /* aalto-base-color__school--elec2 */
    --on-brand: #ffffff;
    --yellow:   #F7E159;

    --max-width: 820px;
    --gutter: 62px;        /* year / date column, shared by papers and news */
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --page:        #0d0d0e;
      --ink:         #f3f3f1;
      --ink-2:       #b0b0ad;
      --ink-3:       #76767a;
      --rule:        #2a2a2c;
      --rule-strong: #f3f3f1;
      --surface:     #171719;
      --brand:       #A987FF;
      --on-brand:    #000000;
      color-scheme: dark;
    }
  }

  html {
    font-family: var(--font);
    background: var(--page);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    background: var(--page);
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  a:hover {
    color: var(--brand);
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  ::selection {
    background: var(--yellow);
    color: #000000;
  }

  /* ---- shared section furniture ---- */
  .section-label {
    display: inline-block;
    background: var(--brand);
    color: var(--on-brand);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    padding: 4px 10px;
  }

  .section-rule {
    border-top: 2px solid var(--rule-strong);
  }

  @media (max-width: 560px) {
    body {
      padding: 2.5rem 1.15rem 4.5rem;
    }
    /* a ragged inline block looks broken once a long label wraps,
       so it becomes a full-width band instead */
    .section-label {
      display: block;
    }
  }
</style>
