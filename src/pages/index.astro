---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import PaperCard from "../components/PaperCard.astro";
import News from "../components/News.astro";
import papers from "../data/papers.json";

const byTopic = (t) => papers.filter((p) => p.topic === t);

const sections = [
  {
    title: "Efficient and Reliable Visual Document Intelligence",
    blurb: "Making vision-language document retrieval cheap enough to deploy, and asking what those systems ground their answers on and what their indices leak.",
    papers: [...byTopic("retrieval"), ...byTopic("privacy"), ...byTopic("understanding")],
  },
  {
    title: "Other Multimodal Information Understanding",
    blurb: "E-textile design, wearable sensing and human motion, mostly with collaborators.",
    papers: byTopic("motion"),
    compact: true,
  },
];
---

<Base title="Zhuchenyang Liu">
  <Header />

  <main>
    <News />

    {sections.map((section) => (
      <section>
        <h2 class="section-title">{section.title}</h2>
        <p class="section-blurb">{section.blurb}</p>
        <div class="paper-list">
          {section.papers.map((p) => (
            <PaperCard
              title={p.title}
              authors={p.authors}
              venue={p.venue}
              arxiv={p.arxiv}
              hook={p.hook}
              links={p.links}
              compact={section.compact === true || p.role === "second"}
            />
          ))}
        </div>
      </section>
    ))}
  </main>

  <footer>
    <p class="funding">
      Supported by the <a href="https://www.businessfinland.fi/" target="_blank" rel="noopener noreferrer">Business Finland</a>
      co-innovation programme (AiWo, 2025–2027), enhancing human-AI collaboration across manufacturing,
      construction and industrial design.
    </p>
    <p>&copy; 2026 Zhuchenyang Liu. Built with Astro.</p>
  </footer>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .section-blurb {
    font-size: 0.83rem;
    color: var(--text-tertiary);
    line-height: 1.5;
    margin: 0 0 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 3px solid var(--aalto-violet);
    max-width: 640px;
  }

  .paper-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  footer {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }

  .funding {
    max-width: 620px;
    margin: 0 auto 0.9rem;
    line-height: 1.55;
    font-size: 0.78rem;
  }
</style>
