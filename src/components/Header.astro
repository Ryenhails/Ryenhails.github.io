<style>
  header {
    margin-bottom: 3.25rem;
  }

  .header-top {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.15rem;
  }

  .affiliation {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .email {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .bio {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 640px;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .interests-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-tertiary);
    margin: 0 0 0.45rem 0;
  }

  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 640px;
  }

  .interests li {
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    background: var(--tag-bg);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    transition: all 0.15s;
  }

  .interests li:hover {
    background: var(--tag-first);
    color: var(--tag-first-text);
    border-color: var(--tag-first);
  }


  nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .sep {
    color: var(--text-tertiary);
    user-select: none;
  }

  @media (max-width: 480px) {
    .header-top {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    nav {
      justify-content: center;
    }
