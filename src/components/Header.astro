---
const links = [
  { label: "Google Scholar", href: "https://scholar.google.com/citations?user=70LuG5cAAAAJ" },
  { label: "GitHub", href: "https://github.com/Ryenhails" },
  { label: "HuggingFace", href: "https://huggingface.co/Ryenhails" },
  { label: "Kaggle", href: "https://www.kaggle.com/ryenhails" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/zhuchenyang-liu-2a6745202/" },
  { label: "CV", href: "/cv.pdf" },
];
---
<header>
  <div class="top">
    <img src="/images/photo.jpg" alt="Zhuchenyang Liu" class="portrait" width="96" height="96" />
    <div class="id">
      <h1 class="name">Zhuchenyang Liu</h1>
      <p class="role">
        PhD Candidate, <a href="https://mobilecloud.aalto.fi/" target="_blank" rel="noopener noreferrer">Mobile Cloud Computing Group</a>, Aalto University
      </p>
      <p class="bio">
        I am a PhD candidate at Aalto University, supervised by Prof. Yu Xiao, working on Efficient and
        Reliable Visual Document Intelligence. I am also interested in general multimodal information
        understanding. I obtained a dual M.Sc. in Data Science from KTH and Aalto University with
        honours, and I am a Kaggle Competitions Master.
      </p>
      <div class="links">
        {links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </div>
      <p class="email">zhuchenyang.liu@aalto.fi</p>
    </div>
  </div>
</header>

<style>
  header {
    margin-bottom: 3.25rem;
  }

  .top {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  /* square, like every other block on the page */
  .portrait {
    width: 96px;
    height: 96px;
    object-fit: cover;
    display: block;
    flex: none;
  }

  .id {
    min-width: 0;
    flex: 1 1 260px;
  }

  .name {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0 0 6px;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 14px;
    line-height: 1.5;
  }

  .bio {
    margin: 0;
    max-width: 62ch;
    color: var(--ink);
  }

  /* collapsed hard borders: one continuous rule, not a row of pills */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 16px;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 5px 11px;
    border: 1px solid var(--rule-strong);
    margin: 0 -1px -1px 0;
  }

  .links a:hover {
    background: var(--brand);
    color: var(--on-brand);
  }

  .email {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    margin-top: 14px;
  }

  @media (max-width: 560px) {
    .top {
      gap: 14px;
    }
    .portrait {
      width: 76px;
      height: 76px;
    }
    .name {
      font-size: 30px;
    }
    header {
      margin-bottom: 2.5rem;
    }
  }
</style>
