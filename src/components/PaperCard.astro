---
interface Props {
  title: string;
  authors: string[];
  venue: string;
  year?: number | string;
  arxiv?: string;
  hook: string;
  links?: Record<string, string>;
  selfName?: string;
  compact?: boolean;
}

const {
  title,
  authors,
  venue,
  year,
  arxiv,
  hook,
  links = {},
  selfName = "Zhuchenyang Liu",
  compact = false,
} = Astro.props;

const isPreprint = /preprint|under review|submitted/i.test(venue);
const linkEntries = Object.entries(links);
// once a paper is published the proceedings page is the version of record;
// otherwise arXiv, and failing that whatever external link exists
const titleHref =
  links.acl ?? (arxiv ? `https://arxiv.org/abs/${arxiv}` : (linkEntries[0]?.[1] ?? "#"));

// link keys are shown capitalised, which would turn "acl" into "Acl"
const LABELS = { acl: "ACL Anthology" };
---

<article class={compact ? "item compact" : "item"}>
  <div class="year">{year}</div>
  <div class="body">
    <h3 class="title">
      <a href={titleHref} target="_blank" rel="noopener noreferrer">{title}</a>
    </h3>

    <p class="authors">
      {authors.map((author, i) => (
        <>
          {i > 0 && ", "}
          {author === selfName ? <b>{author}</b> : <span>{author}</span>}
        </>
      ))}
    </p>

    {!compact && <p class="hook">{hook}</p>}

    <div class="meta">
      <span class={isPreprint ? "venue preprint" : "venue"}>{venue}</span>
      <div class="paper-links">
        {arxiv && (
          <>
            <a href={`https://arxiv.org/abs/${arxiv}`} target="_blank" rel="noopener noreferrer" class="lk">arXiv</a>
            <a href={`https://arxiv.org/pdf/${arxiv}`} target="_blank" rel="noopener noreferrer" class="lk">PDF</a>
          </>
        )}
        {linkEntries.map(([label, url]) => (
          <a href={url} target="_blank" rel="noopener noreferrer" class="lk">{LABELS[label] ?? label}</a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .item {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .body {
    min-width: 0;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    padding-top: 3px;
  }

  /* the scan anchor */
  .title {
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.35;
    margin: 0 0 4px;
  }

  .title a {
    text-decoration: none;
  }

  .authors {
    font-size: 13px;
    color: var(--ink-2);
    margin: 0 0 7px;
    line-height: 1.5;
  }

  .authors b {
    font-weight: 600;
    color: var(--ink);
  }

  /* one-line takeaway, marked by the brand rule rather than by weight */
  .hook {
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0 0 9px;
    border-left: 3px solid var(--brand);
    padding-left: 10px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .venue {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.03em;
    line-height: 1.45;
    background: var(--brand);
    color: var(--on-brand);
    padding: 3px 7px;
  }

  .venue.preprint {
    background: transparent;
    color: var(--ink-3);
    border: 1px solid var(--rule);
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lk {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    text-transform: capitalize;
  }

  .lk:hover {
    color: var(--brand);
    border-color: var(--brand);
  }

  /* ---- compact: co-authored / side work ---- */
  .item.compact {
    padding: 12px 0;
  }

  .item.compact .title {
    font-size: 14px;
    font-weight: 500;
  }

  .item.compact .authors {
    font-size: 12.5px;
    margin-bottom: 6px;
  }

  @media (max-width: 560px) {
    .item {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .year {
      display: none;
    }
  }
</style>
