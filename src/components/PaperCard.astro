---
interface Props {
  title: string;
  authors: string[];
  venue: string;
  arxiv: string;
  hook: string;
  links?: Record<string, string>;
  selfName?: string;
  compact?: boolean;
}

const {
  title,
  authors,
  venue,
  arxiv,
  hook,
  links = {},
  selfName = "Zhuchenyang Liu",
  compact = false,
} = Astro.props;

const isPreprint = /preprint|under review|submitted/i.test(venue);
---

<article class={compact ? "paper-card compact" : "paper-card"}>
  <h3 class="paper-title">
    <a href={`https://arxiv.org/abs/${arxiv}`} target="_blank" rel="noopener noreferrer">{title}</a>
  </h3>

  {!compact && <p class="hook">{hook}</p>}

  <p class="authors">
    {authors.map((author, i) => (
      <>
        {i > 0 && ", "}
        {author === selfName ? <strong>{author}</strong> : <span>{author}</span>}
      </>
    ))}
  </p>

  <div class="paper-meta">
    <span class={isPreprint ? "venue" : "venue venue-accepted"}>{venue}</span>
    <div class="paper-links">
      <a href={`https://arxiv.org/abs/${arxiv}`} target="_blank" rel="noopener noreferrer" class="link-pill">arXiv</a>
      <a href={`https://arxiv.org/pdf/${arxiv}`} target="_blank" rel="noopener noreferrer" class="link-pill">PDF</a>
      {Object.entries(links).map(([label, url]) => (
        <a href={url} target="_blank" rel="noopener noreferrer" class="link-pill">{label}</a>
      ))}
    </div>
  </div>
</article>

<style>
  .paper-card {
    padding: 1.1rem 1.35rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .paper-card:hover {
    border-color: var(--text-tertiary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  /* title is the scan anchor */
  .paper-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .paper-title a { color: var(--text); }
  .paper-title a:hover { color: var(--accent); }

  /* one-line takeaway, subordinate to the title */
  .hook {
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.55;
    margin: 0.5rem 0 0.6rem;
    padding-left: 0.7rem;
    border-left: 2px solid var(--tag-first);
  }

  .authors {
    font-size: 0.83rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0.35rem 0 0.5rem;
  }

  .paper-meta {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .venue {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-style: italic;
  }

  .venue-accepted {
    font-style: normal;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--tag-first-text);
    background: var(--tag-first);
    border-radius: 6px;
    padding: 0.18rem 0.5rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .paper-links {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  /* quiet by default so 30+ links stop competing with titles */
  .link-pill {
    font-size: 0.72rem;
    padding: 0.16rem 0.45rem;
    border-radius: 5px;
    background: var(--tag-bg);
    color: var(--text-tertiary);
    border: 1px solid transparent;
    transition: all 0.15s;
    text-transform: capitalize;
  }

  .link-pill:hover {
    background: var(--tag-first);
    color: var(--tag-first-text);
    border-color: var(--tag-first);
  }

  /* ---- compact: co-authored / side work ---- */
  .paper-card.compact {
    padding: 0.7rem 0;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
  }

  .paper-card.compact:hover {
    box-shadow: none;
    border-color: var(--border);
  }

  .paper-card.compact .paper-title {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .paper-card.compact .authors {
    font-size: 0.78rem;
    margin: 0.2rem 0 0.35rem;
  }
</style>
