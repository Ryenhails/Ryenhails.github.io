---
const news = [
  {
    date: "Oct 2026",
    text: '<strong>VisAgentRet</strong>, our OCR-free agentic document retrieval system (EVIE-4.5B + GLM-5.3-Flash), ranks 1st on the <a href="https://huggingface.co/spaces/vidore/vidore-leaderboard" target="_blank" rel="noopener noreferrer">ViDoRe v3 leaderboard</a>.',
  },
  {
    date: "Oct 2026",
    text: 'New preprint on VDR privacy online: <a href="https://arxiv.org/abs/2610.09920" target="_blank" rel="noopener noreferrer">Inverting Multi-Vector Visual Document Indices</a>.',
  },
  {
    date: "Sep 2026",
    text: '<a href="https://arxiv.org/abs/2608.10636" target="_blank" rel="noopener noreferrer">DistilVDR</a> is accepted to <strong>DocInsights 2026</strong>, the Workshop on Document Intelligence and Understanding at EMNLP 2026.',
  },
  {
    date: "Aug 2026",
    text: 'Two papers, <a href="https://arxiv.org/abs/2603.12824" target="_blank" rel="noopener noreferrer">NanoVDR</a> and <a href="https://arxiv.org/abs/2601.20107" target="_blank" rel="noopener noreferrer">SAP</a>, are accepted to <strong>EMNLP 2026</strong> (Main). See you in Budapest!',
  },
  {
    date: "Jul 2026",
    text: 'Giving an oral presentation at the <strong>ACM SIGCHI Symposium on Engineering Interactive Computing Systems (EICS 2026)</strong> in Greece on our <a href="https://dl.acm.org/doi/10.1145/3816771" target="_blank" rel="noopener noreferrer">human-AI collaboration for sensor placement in human motion sensing</a> work.',
  },
  {
    date: "Apr 2026",
    text: 'Our paper on human-AI collaboration in LLM-assisted design is accepted to <em>Proceedings of the ACM on Human-Computer Interaction</em>.',
  },
  {
    date: "Apr 2026",
    text: '<a href="https://ryenhails.github.io/IKEA-Bench/" target="_blank" rel="noopener noreferrer">IKEA-Bench</a> released — 1,623 questions benchmarking 19 VLMs on cross-depiction assembly alignment.',
  },
  {
    date: "Apr 2026",
    text: 'Academic visit to the <a href="https://www.southampton.ac.uk/" target="_blank" rel="noopener noreferrer">University of Southampton</a>, UK.',
  },
  {
    date: "Mar 2026",
    text: 'NanoVDR is now on <a href="https://huggingface.co/nanovdr" target="_blank" rel="noopener noreferrer">HuggingFace</a> — full datasets, models, and an online demo.',
  },
  {
    date: "Oct 2025",
    text: 'Academic visit to <a href="https://www.tum.de/" target="_blank" rel="noopener noreferrer">TUM</a> and <a href="https://www.lmu.de/" target="_blank" rel="noopener noreferrer">LMU Munich</a>.',
  },
];

const RECENT = 4;
const recent = news.slice(0, RECENT);
const older = news.slice(RECENT);
---

<section>
  <span class="section-label">News</span>
  <div class="section-rule"></div>
  <ul class="news-list">
    {recent.map((item) => (
      <li class="news-item">
        <span class="news-date">{item.date}</span>
        <span class="news-text" set:html={item.text} />
      </li>
    ))}
  </ul>
  {older.length > 0 && (
    <details class="older-news">
      <summary>Earlier news ({older.length})</summary>
      <ul class="news-list">
        {older.map((item) => (
          <li class="news-item">
            <span class="news-date">{item.date}</span>
            <span class="news-text" set:html={item.text} />
          </li>
        ))}
      </ul>
    </details>
  )}
</section>

<style>
  .news-list {
    list-style: none;
    margin-top: 2px;
  }

  .news-item {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .news-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    padding-top: 2px;
    white-space: nowrap;
  }

  .news-text {
    min-width: 0;
    color: var(--ink-2);
  }

  .news-text :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .older-news {
    margin-top: 12px;
  }

  .older-news summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 4px 9px;
    border: 1px solid var(--rule);
    transition: color 0.15s, border-color 0.15s;
  }

  .older-news summary::-webkit-details-marker {
    display: none;
  }

  .older-news summary::before {
    content: "+";
  }

  .older-news[open] summary::before {
    content: "\2212";
  }

  .older-news summary:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .older-news .news-list {
    margin-top: 10px;
  }

  /* the last rule in a block has nothing below it to separate */
  .news-list .news-item:last-child {
    border-bottom: none;
  }

  @media (max-width: 560px) {
    .news-item {
      grid-template-columns: 1fr;
      gap: 3px;
    }
  }
</style>
